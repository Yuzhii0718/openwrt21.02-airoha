		reg = <0x1fa72100 0x4a0>,		//PCS mode1 range
			<0x1fa72a00 0x160>,		//PCS mode2 range
			<0x1fa72000 0x64>,		//AN range
			<0x1fa72600 0xdc>,		//rate adaption range
