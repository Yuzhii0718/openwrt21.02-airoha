		compatible = "econet,ecnt-sgmii";
		reg = <0x1fa81100 0x4a0>,		//PCS mode1 range
			<0x1fa81a00 0x160>,		//PCS mode2 range
			<0x1fa81000 0x64>,		//AN range
			<0x1fa81600 0xdc>,		//rate adaption range
			<0x1fa81c00 0x3b0>;		//phya
		interrupts = <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>;	// usb_hsgmii INT 137+16
		int_name = "sgmii_usb0";
		int_id = <2>;
	};
*/

	usb_phy@1fac0000 {
		compatible = "econet,ecnt-usb_phy";
		reg = <0x1fac0000 0x1400>;		
	};

	i2s@1fbe2200 {
		compatible = "econet,ecnt-i2s";
		reg = <0x1fbe2200 0xfc>,
			  <0x1fbe2e00 0x114>;
		interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>;		
	};
	
	ipsec: ipsec@1fbfa000 {
		compatible = "econet,ecnt-ipsec";
		reg = <0x1fbfa000 0x268>;
		interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>; // IPSEC_INTR 63+16
	};
	
	mdio: mdio-bus {
		compatible = "airoha,arht-mdio";
		phy13: phy@13 {		
			reg = <13>;
		};
		phy14: phy@14 {		
			reg = <14>;
		};
		phy15: phy@15 {		
			reg = <15>;
		};
	};

};
