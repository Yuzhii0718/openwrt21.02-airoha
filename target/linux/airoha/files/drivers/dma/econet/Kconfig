
config ECNT_HSDMA
	tristate "ECONET High-Speed DMA controller support"
	depends on ARCH_ECONET || COMPILE_TEST
	select DMA_ENGINE
	select DMA_OF
	select DMA_VIRTUAL_CHANNELS
	---help---
	  Enable support for High-Speed DMA controller on ECONET
	  SoCs.

	  This controller provides the channels which is dedicated to
	  memory-to-memory transfer to offload from CPU through ring-
	  based descriptor management.
