#!/bin/sh

. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

BOARD_TYPE=""

check_board_type() {
    local output=$(ethphxcmd gswr 2610)
    if [ $? -ne 0 ]; then
        return 1
    fi

    local value=$(echo "$output" | grep -o 'value:[0-9a-fA-F]*' | cut -d ':' -f 2)
    if [ -z "$value" ]; then
        return 1
    fi

    local result=$((0x$value & 0x20))

    if [ "$result" -eq 32 ]; then
        BOARD_TYPE="dsa"
    else
        BOARD_TYPE="gsw"
    fi
}

mediatek_setup_interfaces()
{
    check_board_type
    if [ $? -ne 0 ]; then
        return 1
    fi

    board=$BOARD_TYPE
	case $board in
	*fpga*)
		ucidef_set_interfaces_lan_wan "eth0" "eth1"
		ucidef_add_switch "switch0" \
			"0:lan" "1:lan" "2:lan" "3:lan" "4:wan" "6u@eth0" "5u@eth1"
		;;
	*gsw*)
		ucidef_set_interfaces_lan_wan "eth0" ae_wan
		ucidef_add_switch "switch0" \
			"0:lan" "1:lan" "2:lan" "3:lan" "6u@eth0"
		;;
	*)
		ucidef_set_interfaces_lan_wan "eth0.1 eth0.2 eth0.3 eth0.4 eth1" ae_wan
		;;
	esac
}

mediatek_setup_macs()
{
	local board="$1"
	local part_name="Factory"
	local lan2_mac=""
	local lan_mac=""
	local wan_mac=""
	local lan2_mac_offset=""
	local lan_mac_offset=""
	local wan_mac_offset=""

	case $board in
	*)
		lan_mac_offset="0x1FFFF4"
		wan_mac_offset="0x1FFFFA"
		;;
	esac

	lan2_mac=$(mtd_get_mac_binary $part_name $lan2_mac_offset)
	lan_mac=$(mtd_get_mac_binary $part_name $lan_mac_offset)
	wan_mac=$(mtd_get_mac_binary $part_name $wan_mac_offset)

	case "$lan2_mac" in
		00:00:00:00:00:00);;
		ff:ff:ff:ff:ff:ff);;
		*)
		[ -n "$lan2_mac" ] && ucidef_set_interface_macaddr "lan2" "$lan2_mac"
	;;
	esac

	case "$lan_mac" in
		00:00:00:00:00:00);;
		ff:ff:ff:ff:ff:ff);;
		*)
		[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	;;
	esac

	case "$wan_mac" in
		00:00:00:00:00:00);;
		ff:ff:ff:ff:ff:ff);;
		*)
		[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	;;
	esac
}

board_config_update
board=$(board_name)
mediatek_setup_interfaces $board
mediatek_setup_macs $board
board_config_flush

exit 0
