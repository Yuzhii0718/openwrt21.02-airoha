diff --no-dereference -Naur a/net/netfilter/regexp/regsub.c b/net/netfilter/regexp/regsub.c
--- a/net/netfilter/regexp/regsub.c	1970-01-01 08:00:00.000000000 +0800
+++ b/net/netfilter/regexp/regsub.c	2024-01-05 23:40:03.647201000 +0800
