+int br_arp_packet(struct sk_buff *skb, unsigned char *br_dest, const unsigned char *dest)
+{
+    struct ethhdr *eth;
+    struct eth_arphdr *parp = NULL;
+    struct device_list_table g_deviceListTable;
+    eth = (struct ethhdr *)skb_mac_header(skb);
+    if (eth &&  eth->h_proto == htons(ETHERTYPE_ARP))
+    {
+        parp = (struct eth_arphdr *)(eth+1);
+        if(parp)
+        {
+            if (parp->ar_pro == htons(ETH_P_IP))
+            {
+                //printk("arp %s")
+                memset(&g_deviceListTable, 0, sizeof(struct device_list_table));
+                g_deviceListTable.pkttype = (int)'a';
+                memcpy(g_deviceListTable.mac, parp->ar_sha, ETH_ALEN);
+                memcpy(g_deviceListTable.ip, parp->ar_sip, 4);
+                send_msg_to_user(g_deviceListTable);
+                //printk("arp %02x:%02x:%02x:%02x:%02x:%02x   %d.%d.%d.%d\n", parp->ar_sha[0], parp->ar_sha[1], parp->ar_sha[2], parp->ar_sha[3], parp->ar_sha[4], parp->ar_sha[5]
+                //, parp->ar_sip[0], parp->ar_sip[1], parp->ar_sip[2], parp->ar_sip[3]);
+            }
+        }
+    }
+    return 0;
+}
