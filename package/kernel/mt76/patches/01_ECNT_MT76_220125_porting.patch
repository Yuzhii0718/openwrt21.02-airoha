+        power_list = group.path_power_list
+    else:
+        return
+
+    res = []
+
+    idx = 0
+    pre_sg = sku_groups[0]
+    pre_power = power_list[pre_sg['start']:pre_sg['start'] + pre_sg['len']]
+    for sg in sku_groups:
+        power = power_list[sg['start']:sg['start'] + sg['len']]
+
+        if power == pre_power:
+            idx += 1
+            continue
+
+        # pad a leading zero to some bf path groups
+        if pre_sg in [PATH_BW20_BF, PATH_BW40_BF, PATH_BW80_BF, PATH_BW160_BF]:
+            res.append('<{} 0 {}>'.format(idx, ' '.join(pre_power)))
+        else:
+            res.append('<{} {}>'.format(idx, ' '.join(pre_power)))
+        pre_sg = sg
+        pre_power = power
+        idx = 1
+
+    if pre_sg in [PATH_BW20_BF, PATH_BW40_BF, PATH_BW80_BF, PATH_BW160_BF]:
+        res.append('<{} 0 {}>'.format(idx, ' '.join(pre_power)))
+    else:
+        res.append('<{} {}>'.format(idx, ' '.join(pre_power)))
+
+    print('\t\t{} = '.format(form))
+    for i in range(len(res)):
+        r = res[i]
+        end = ';' if i == len(res) - 1 else ','
+        print('\t\t{}{}'.format(r, end))
+
+
+def print_sku_group(group_list, name):
+    idx = 1
+
+    print(name + ' {')
+
+    for g in group_list:
+        print('\tr{} {{'.format(idx))
+        print('\t\tchannels = <{} {}>;'.format(g.channel[0], g.channel[-1]))
+        print('\t\ttxs_delta = <0 0 0>;')
+
+        if g.rate_power_list:
+            if '2g' in name:
+                print(
+                    '\t\trates-cck = <{}>;'.format(' '.join(g.rate_power_list[:4])))
+
+            print(
+                '\t\trates-ofdm = <{}>;'.format(' '.join(g.rate_power_list[4:12])))
+            print_sku_mcs_ru(g, 'rates-mcs')
+            print_sku_mcs_ru(g, 'rates-ru')
+            print('')
+
+        if g.path_power_list:
+            if '2g' in name:
+                print(
+                    '\t\tpaths-cck = <{}>;'.format(' '.join(g.path_power_list[:4])))
+
+            print('\t\tpaths-ofdm = <{} {}>,'.format(1,
+                                                     ' '.join(g.path_power_list[4:8])))
+            print('\t\t<{} 0 {}>;'.format(
+                1, ' '.join(g.path_power_list[8:11])))
+            print_sku_mcs_ru(g, 'paths-ru')
+            print_sku_mcs_ru(g, 'paths-ru-bf')
+            pass
+
+        print('\t};')
+        idx += 1
+
+    print('};')
+
+
+def main():
+    argpar = argparse()
+    args = argpar.parse_args()
+
+    group_2g = []
+    group_5g = []
+
+    if args.sku:
+        rate_ch = {'2g': [], '5g': []}
+        rate_power_list = {'2g': [], '5g': []}
+
+        parse_ch_power(args.sku, rate_ch, rate_power_list, args.scalar)
+        form_sku_rate_group(group_2g, rate_ch['2g'], rate_power_list['2g'])
+        form_sku_rate_group(group_5g, rate_ch['5g'], rate_power_list['5g'])
+        #print(rate_ch)
+        # print(rate_power_list)
+
+    if args.sku2:
+        path_ch = {'2g': [], '5g': []}
+        path_power_list = {'2g': [], '5g': []}
+
+        parse_ch_power(args.sku2, path_ch, path_power_list)
+
+        if not args.sku:
+            form_sku_path_group(group_2g, path_ch['2g'], path_power_list['2g'])
+            form_sku_path_group(group_5g, path_ch['5g'], path_power_list['5g'])
+        else:
+            if sorted(rate_ch['2g']) != sorted(path_ch['2g']) or \
+               sorted(rate_ch['5g']) != sorted(path_ch['5g']):
+                print('Please align channel list of two files')
+                sys.exit(-1)
+
+            group_path_2g = []
+            group_path_5g = []
+
+            form_sku_path_group(
+                group_path_2g, path_ch['2g'], path_power_list['2g'])
+            form_sku_path_group(
+                group_path_5g, path_ch['5g'], path_power_list['5g'])
+
+            group_2g = merge_sku_rate_path_group(
+                group_2g, group_path_2g, path_ch['2g'])
+            group_5g = merge_sku_rate_path_group(
+                group_5g, group_path_5g, path_ch['5g'])
+            print(path_ch)
+            print(path_power_list)
+
+    # for debug
+    #show_sku_group(group_2g)
+    #show_sku_group(group_5g)
+
+    # print to dts format
+    print_sku_group(group_2g, "txpower-2g")
+    print_sku_group(group_5g, "txpower-5g")
+
+
+if __name__ == '__main__':
+    main()
