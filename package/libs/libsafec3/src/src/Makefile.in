	-rm -rf extmem/.libs extmem/_libs
	-rm -rf extstr/.libs extstr/_libs
	-rm -rf extwchar/.libs extwchar/_libs
	-rm -rf io/.libs io/_libs
	-rm -rf mem/.libs mem/_libs
