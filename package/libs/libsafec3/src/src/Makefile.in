libsafec-@SAFEC_API_VERSION@.la: $(libsafec_@SAFEC_API_VERSION@_la_OBJECTS) $(libsafec_@SAFEC_API_VERSION@_la_DEPENDENCIES) $(EXTRA_libsafec_@SAFEC_API_VERSION@_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libsafec_@SAFEC_API_VERSION@_la_LINK) -rpath $(libdir) $(libsafec_@SAFEC_API_VERSION@_la_OBJECTS) $(libsafec_@SAFEC_API_VERSION@_la_LIBADD) $(LIBS)

libsafeccore.la: $(libsafeccore_la_OBJECTS) $(libsafeccore_la_DEPENDENCIES) $(EXTRA_libsafeccore_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(LINK)  $(libsafeccore_la_OBJECTS) $(libsafeccore_la_LIBADD) $(LIBS)
io/tmpnam_s.lo: io/$(am__dirstamp) io/$(DEPDIR)/$(am__dirstamp)

libstdunsafe.la: $(libstdunsafe_la_OBJECTS) $(libstdunsafe_la_DEPENDENCIES) $(EXTRA_libstdunsafe_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(LINK) $(am_libstdunsafe_la_rpath) $(libstdunsafe_la_OBJECTS) $(libstdunsafe_la_LIBADD) $(LIBS)

