.c.i:
	$(AM_V_CC)depbase=`echo $@ | sed 's|[^/]*$$|$(DEPDIR)/&|;s|\.o$$||'`;\
	$(COMPILE) -MT $@ -MD -MP -MF $$depbase.Tpo -c -E -o $@ $<
#	-export-symbols $(EXPORT_SYM)
#libsafec_@SAFEC_API_VERSION@_la_DEPENDENCIES = $(EXPORT_SYM)

# emacs flymake-mode
check-syntax:
	test -n "$(CHK_SOURCES)" && \
	  $(COMPILE) -o /dev/null -S $(CHK_SOURCES)
.PHONY: check-syntax
@ENABLE_GCOV_TRUE@gcov:
@ENABLE_GCOV_TRUE@	-test -f $(top_builddir)/gcov.log && rm $(top_builddir)/src/gcov.log
@ENABLE_GCOV_TRUE@	for c in $(libsafec_@SAFEC_API_VERSION@_la_SOURCES); do \
@ENABLE_GCOV_TRUE@	  dir="`dirname $$c`"; base="`basename $$c .c`"; \
@ENABLE_GCOV_TRUE@	  if test -e "$$dir/$$base.gcno" -a -e $$c; then \
@ENABLE_GCOV_TRUE@	    $(GCOV) -s $$dir $$c | tee -a $(top_builddir)/src/gcov.log; \
@ENABLE_GCOV_TRUE@	    mv $$base.c.gcov $$dir/ ; \
@ENABLE_GCOV_TRUE@	  fi; \
@ENABLE_GCOV_TRUE@	done

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
