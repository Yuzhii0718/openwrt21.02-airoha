#	$(COMPILE) -MT $@ -MD -MP -MF $$depbase.Tpo -o $@ $<
@HAVE_ATTRIBUTE_DIAGNOSE_IF_FALSE@tests: $(TESTS)

.c.i:
	$(AM_V_CC)depbase=`echo $@ | sed 's|[^/]*$$|$(DEPDIR)/&|;s|\.o$$||'`;\
	$(COMPILE) -MT $@ -MD -MP -MF $$depbase.Tpo -c -E -o $@ $<
#  -e's,$(EXEEXT),,'
@ENABLE_GCOV_TRUE@gcov: $(TESTS)
@ENABLE_GCOV_TRUE@	-test -f gcov.log && rm gcov.log
@ENABLE_GCOV_TRUE@	for f in $(TESTS); do \
@ENABLE_GCOV_TRUE@	  c="`echo $$f|sed -e's,t_,test_,'`.c"; \
@ENABLE_GCOV_TRUE@	  echo $(GCOV) $$c; test -e $$c && $(GCOV) $$c >>gcov.log; done

@VALGRIND_CHECK_RULES@
#VALGRIND_SUPPRESSIONS_FILES = $(PACKAGE).supp
#EXTRA_DIST = $(PACKAGE).supp

# emacs flymake-mode
check-syntax:
	test -n "$(CHK_SOURCES)" && \
	  $(COMPILE) -o /dev/null -S $(CHK_SOURCES)
@HAVE_ATTRIBUTE_DIAGNOSE_IF_TRUE@.PHONY: check-syntax tests-bos
@HAVE_ATTRIBUTE_DIAGNOSE_IF_FALSE@.PHONY: check-syntax

@HAVE_DSYMUTIL_TRUE@clean-local:
@HAVE_DSYMUTIL_TRUE@	rm -rf *.dSYM

