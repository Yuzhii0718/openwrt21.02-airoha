+/*
+ * UBI-variant support: on UBI-based layouts the factory/NVRAM data lives in
+ * UBI volumes instead of raw MTD partitions. libnvram historically looked the
+ * data up by the MTD partition names "Factory" and "facenv"; map those onto
+ * the UBI volume names used by the production image and access them through
+ * the matching /dev/ubiblock0_<vol_id> block device.
+ */
+static const char *ubi_vol_for(const char *name)
+{
+	if (strstr(name, "acenv"))		/* facenv -> areaconf */
+		return "areaconf";
+	if (strstr(name, "actory"))		/* Factory -> factory */
+		return "factory";
+	return name;
+}
+
+/* Set when ubi_vol_open() refused a write because the ubiblock device is
+ * read-only, so that flash_write() can stay quiet about the expected failure.
+ * The explanatory message is printed only once per process.
+ */
+static int ubi_write_refused;
+static int ubi_ro_warned;
+
+static int ubi_vol_open(const char *volname, int flags)
+{
+	/* UBI sysfs is normally at /sys/class/ubi; keep the devices path as a
+	 * fallback for kernels that do not create the class symlinks.
+	 */
+	static const char *const base_dirs[] = {
+		"/sys/class/ubi/ubi0",
+		"/sys/devices/virtual/ubi/ubi0",
+		NULL
+	};
+	char syspath[192], devpath[80], vname[160];
+	struct dirent *de;
+	DIR *d;
+	int fd, n, id, i;
+
+	for (i = 0; base_dirs[i]; i++) {
+		d = opendir(base_dirs[i]);
+		if (!d)
+			continue;
+		while ((de = readdir(d))) {
+			if (sscanf(de->d_name, "ubi0_%d", &id) != 1)
+				continue;
+			snprintf(syspath, sizeof(syspath),
+				 "%s/ubi0_%d/name", base_dirs[i], id);
+			if ((fd = open(syspath, O_RDONLY)) < 0)
+				continue;
+			n = read(fd, vname, sizeof(vname) - 1);
+			close(fd);
+			if (n <= 0)
+				continue;
+			vname[n] = '\0';
+			if (vname[n - 1] == '\n')
+				vname[n - 1] = '\0';
+			if (!strcmp(vname, volname)) {
+				snprintf(devpath, sizeof(devpath),
+					 "/dev/ubiblock0_%d", id);
+				closedir(d);
+				fd = open(devpath, flags);
+				if (fd < 0 && (flags & (O_WRONLY | O_RDWR))) {
+					int saved = errno;
+
+					ubi_write_refused = 1;
+					if (!ubi_ro_warned) {
+						ubi_ro_warned = 1;
+						fprintf(stderr,
+							"libnvram: UBI volume \"%s\" (%s) is read-only (ubiblock); writes are not supported\n",
+							volname, devpath);
+					}
+					errno = saved;
+				}
+				return fd;
+			}
+		}
+		closedir(d);
+	}
+	fprintf(stderr,
+		"libnvram: UBI volume \"%s\" not found (no matching /dev/ubiblock0_*)\n",
+		volname);
+	return -1;
+}
