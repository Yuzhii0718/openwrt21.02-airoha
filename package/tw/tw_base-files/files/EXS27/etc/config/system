config system
	option hostname 'OpenWrt'
	option timezone 'UTC'
	option ttylogin '1'
	option log_size '2048'
	option log_file '/var/log/syslog.txt'
	option urandom_seed '0'
	option softVersion 'V1.0.1.34'
	option username 'root'
	option password ''
	option passwordEnable '1'
	option rememberMe '0'
	option installByGuiApp 'unknown'
	option manageByGui '0'
	option manageByApp '0'
	option installByWPS '0'
	option productFamily 'rangeExtender'
	option guiInstallHijack 'Page Seen'
	option disableTelnet '1'
	option axmodel 'BE5000'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	option period '120'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
