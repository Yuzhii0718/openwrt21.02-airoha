preinit_reset_uci() {
	local factory_mode=`envctl factory get factory_mode`
	echo "preinit reset uci config"
	echo 1 > /var/cfu_reboot_flag ## add reboot flag file, used for CFU to call boot_notify() after reboot;
	if [ -e /tmp/.restore ] || [ "$factory_mode" != "off" ]; then
		#snyc_derivativeModel_default
		snyc_default_region
		reset_uci_region
		#reset_uci_pinCode   //not support pincode now.
		#reset_uci_deviceName
		reset_uci_wireless
		reset_uci_system
		reset_uci_deviceName
	fi
	reset_uci_rae
	post_reset_uci_wireless
	sync_softVersion
}

boot_hook_add preinit_main preinit_reset_uci
