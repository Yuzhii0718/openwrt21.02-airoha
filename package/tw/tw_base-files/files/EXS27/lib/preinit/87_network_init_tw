preinit_network_init() {
#   echo 0 > /proc/sys/net/ipv4/neigh/default/gc_thresh1
	echo "preinit network_init"
	if [ -f /etc/crontabs/root ] ; then
		echo "/etc/crontabs/root File exists"
	else
		echo "touch /etc/crontabs/root"
		touch /etc/crontabs/root
	fi
	uci set system.@system[0].passwordEnable='1'
	uci set network.@device[0].stp='1'
	uci commit network
	proto=$(uci get network.lan.proto)
	if [ "$proto" == "dhcp" ]; then
		uci set network.lan.twipaddr='192.168.1.1'
		uci set network.lan.twgateway='192.168.1.1'
		uci set network.lan.twnetmask='255.255.255.0'
		uci set network.lan.twdns='0.0.0.0'
		uci set network.lan.reqip='192.168.1.1'
		uci commit network
	fi
	ebtables  -A OUTPUT -o ra0 -p IPv4 --ip-proto 17 --ip-sport 68 --ip-dport 67 -j DROP
	ebtables  -A OUTPUT -o ra1 -p IPv4 --ip-proto 17 --ip-sport 68 --ip-dport 67 -j DROP
	ebtables  -A OUTPUT -o rai0 -p IPv4 --ip-proto 17 --ip-sport 68 --ip-dport 67 -j DROP
	ebtables  -A OUTPUT -o rai1 -p IPv4 --ip-proto 17 --ip-sport 68 --ip-dport 67 -j DROP

	stpenable=$(uci get network.@device[0].stp)
	if [ "$stpenable" == "1" ]; then
		ebtables  -A OUTPUT -d 01:80:c2:00:00:00 -o apcli0 -j DROP
		ebtables  -A OUTPUT -d 01:80:c2:00:00:00 -o apclii0 -j DROP
	fi

	disableTelnet=$(uci get system.@system[0].disableTelnet)
	if [ $disableTelnet -eq 0 ]; then
		telnetd &
	fi

	conf_mod=$(uci get wireless.2g_5g.conf_mode)
	ethifName=$(uci get network.lan.ifname)
	if [ "x$ethifName" = "x" ] ; then
		ethifName="eth1" 
		#demo硬件先用eth0.1
	fi
	apcli2g=$(uci get wireless.apcli0.ssid)
	apcli5g=$(uci get wireless.apclii0.ssid)
	if [ $conf_mod -eq 2 ]
	then
		if [ "x$apcli2g" != "x" ] || [ "x$apcli5g" != "x" ] ; then
			ebtables  -A OUTPUT -o $ethifName -p IPv4 --ip-proto 17 --ip-sport 68 --ip-dport 67 -j DROP
			#ebtables  -A OUTPUT -o $ethifName -j DROP
		fi
	fi
    
#   uci -q set wireless.2g_5g.wpsLockdown=0
}

boot_hook_add preinit_main preinit_network_init
