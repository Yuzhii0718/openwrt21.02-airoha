
config interface 'loopback'
	option ifname 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	#option ula_prefix 'fdc4:21f6:db91::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option accessctl '0'
	option stp '1'
	option twipaddr '192.168.1.1'
	option twgateway '192.168.1.1'
	option twnetmask '255.255.255.0'
	option twdns '192.168.1.1'
	option ipaddr '192.168.1.1'
	option gateway '192.168.1.1'
	option netmask '255.255.255.0'
	option dns '192.168.1.1'
	option reqip '192.168.1.1'
	option ip6assign '60'
	option linkrootap '9'
	option pingrootap '0'
	option ifname 'eth1'
