	touch $(BSP_APP_OPENSSL_DIR)/Makefile; 
	rm -rf $(BSP_APP_OPENSSL_DIR)/_install_*
	-$(MAKE) -C $(BSP_APP_OPENSSL_DIR) distclean
	rm -rf $(BSP_APP_OPENSSL_DIR)/OPSSL
	rm -rf $(BSP_EXT_FS)/lib/libcrypto.so* 
	rm -rf $(BSP_EXT_FS)/lib/libssl.so*
