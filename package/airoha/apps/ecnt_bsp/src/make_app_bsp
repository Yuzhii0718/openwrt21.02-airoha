openssl_lib:
ifneq ($(strip $(TCSUPPORT_OPENSSL_V1_1)),)
	echo "Compile openssl lib"
	if test -e $(BSP_APP_OPENSSL_DIR)/OPSSL/lib/_install_$(CROSS_COMPILE); \
	then echo "Already compile openssl!"; exit 0; \
	else \
	if test -e $(BSP_APP_OPENSSL_DIR)/checkENV_config.sh; \
		then cd $(BSP_APP_OPENSSL_DIR) && ./checkENV_config.sh; \
		make && make install; \
	else \
		cd $(BSP_APP_OPENSSL_DIR) && ./config enable-shared no-asm --prefix=$(BSP_APP_OPENSSL_DIR)/OPSSL --cross-compile-prefix="" && make && make install; \
	fi; \
	fi
	
	touch $(BSP_APP_OPENSSL_V1_0_DIR)/Makefile
	$(MAKE) -C $(BSP_APP_OPENSSL_V1_0_DIR)
	$(MAKE) install -C $(BSP_APP_OPENSSL_V1_0_DIR)

	if test -e $(BSP_APP_OPENSSL_V1_0_DIR)/OPSSL/lib/libcrypto.so; \
	then echo "Compile openssl success"; \
	cp -rf $(BSP_APP_OPENSSL_V1_0_DIR)/OPSSL $(LIB_INSTALL_DIR)/OPSSLV1_0; \
	rm -f $(LIB_INSTALL_DIR)/OPSSLV1_0/lib/libssl.a; \
	rm -f $(LIB_INSTALL_DIR)/OPSSLV1_0/lib/libssl.so*; \
	rm -f $(LIB_INSTALL_DIR)/OPSSLV1_0/lib/libcrypto.a; \
	rm -f $(LIB_INSTALL_DIR)/OPSSLV1_0/lib/libcrypto.so; \
	cd $(LIB_INSTALL_DIR)/OPSSLV1_0/lib && ln -sf libcrypto.so.1.0.0 libcrypto_1_0.so; \
	cp $(LIB_INSTALL_DIR)/OPSSLV1_0/lib/libcrypto_1_0.so $(BSP_EXT_FS)/lib -avd; \
	cp $(LIB_INSTALL_DIR)/OPSSLV1_0/lib/libcrypto.so.1.0.0 $(BSP_EXT_FS)/lib -avd; \
	touch $(BSP_APP_OPENSSL_V1_0_DIR)/_install_$(CROSS_COMPILE); \
	else echo "Compile openssl error!"; exit 1; \
	fi
else
	echo "Compile openssl lib"
	touch $(BSP_APP_OPENSSL_DIR)/Makefile
	$(MAKE) -C $(BSP_APP_OPENSSL_DIR)
	$(MAKE) install -C $(BSP_APP_OPENSSL_DIR)
endif

	if test -e $(BSP_APP_OPENSSL_DIR)/OPSSL/lib/libcrypto.so; \
	then echo "Compile openssl success"; \
	cp $(BSP_APP_OPENSSL_DIR)/OPSSL/lib/libcrypto.so* $(BSP_EXT_FS)/lib -avd; \
	cp $(BSP_APP_OPENSSL_DIR)/OPSSL/lib/libssl.so*    $(BSP_EXT_FS)/lib -avd; \
	cp -rf $(BSP_APP_OPENSSL_DIR)/OPSSL $(LIB_INSTALL_DIR); \
	touch $(BSP_APP_OPENSSL_DIR)/_install_$(CROSS_COMPILE); \
	else echo "Compile openssl error!"; exit 1; \
	fi

