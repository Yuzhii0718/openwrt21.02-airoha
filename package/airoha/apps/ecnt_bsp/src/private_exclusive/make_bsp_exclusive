bsp_exclusive:$(BSP_EXCLUSIVE_TARGET)
bsp_exclusive_clean:$(BSP_EXCLUSIVE_TARGET_CLEAN)

#Build sysstat
sysstat:
	echo "Build sysstat"
	$(MAKE) -C $(APP_BSP_EXCLUSIVE_PUBLIC_DIR)/tools/sysstat-9.0.4
	if test -e $(APP_BSP_EXCLUSIVE_PUBLIC_DIR)/tools/sysstat-9.0.4/mpstat; \
	then echo "Compile sysstat success"; \
	else echo "Compile sysstat error!"; exit 1; \
	fi
	$(call BspExclUsrBinInstall, $(APP_BSP_EXCLUSIVE_PUBLIC_DIR)/tools/sysstat-9.0.4, mpstat)
	
sysstat_clean:
	echo "Clean sysstat"
	$(MAKE) -C $(APP_BSP_EXCLUSIVE_PUBLIC_DIR)/tools/sysstat-9.0.4 clean
	
	
#Build busybox for bsp
busybox_bsp:
	echo "Building Busybox for BSP"
	cp $(APP_BSP_BUSYBOX_DIR)/busybox_config $(APP_BSP_BUSYBOX_DIR)/.config
	echo "" > $(APP_BSP_BUSYBOX_DIR)/.depend
	
	$(MAKE) -C $(APP_BSP_BUSYBOX_DIR)
	if test -e $(APP_BSP_BUSYBOX_DIR)/busybox; \
	then echo "Compile BusyBox success"; \
	else echo "Compile BusyBox error!"; exit 1; \
	fi
	$(MAKE) -C $(APP_BSP_BUSYBOX_DIR) install
	
ifneq ($(TCSUPPORT_TRACEROUTE),)
	rm -f $(BSP_EXCL_FS)/usr/bin/traceroute
	ln -fs ../../bin/busybox $(BSP_EXCL_FS)/usr/bin/traceroute
endif

busybox_bsp_menuconfig:
	echo "busybox menuconfig"
	echo "Building Busybox menuconfig"
	cp $(APP_BSP_BUSYBOX_DIR)/busybox_config $(APP_BSP_BUSYBOX_DIR)/.config
	$(MAKE) -C $(APP_BSP_BUSYBOX_DIR) menuconfig
	cp $(APP_BSP_BUSYBOX_DIR)/.config  $(APP_BSP_BUSYBOX_DIR)/busybox_config
	
busybox_bsp_clean:
	echo "Clean Busybox"
	$(MAKE) -C $(APP_BSP_BUSYBOX_DIR) clean
	
busybox_1_26_2_bsp_menuconfig:
	echo "busybox app menuconfig"
	#copy if user make menuconfig
	if test -e $(PROFILE_DIR)/busybox_1_26_2.config; \
	then cp $(PROFILE_DIR)/busybox_1_26_2.config $(APP_BSP_BUSYBOX_DIR)/.config; \
	fi
	#copy mow kernel config as busybox_config to support release BSP
	rm -f $(APP_BSP_BUSYBOX_DIR)/busybox1.26.2_config
	$(MAKE) -C $(APP_BSP_BUSYBOX_DIR) menuconfig
	cp $(APP_BSP_BUSYBOX_DIR)/.config  $(PROFILE_DIR)/busybox_1_26_2.config
	
