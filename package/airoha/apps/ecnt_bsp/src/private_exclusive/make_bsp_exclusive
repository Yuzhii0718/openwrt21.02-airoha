###########################################################################################	
iptables_bsp:
	echo "Build iptables 1.6.1"
	# rm -f $(APP_BSP_IPTABLES_DIR)/Makefile 
	# rm -f $(APP_BSP_IPTABLES_DIR)/configure 
	touch -m $(APP_BSP_IPTABLES_DIR)/*
	# cd $(APP_BSP_IPTABLES_DIR) && libtoolize --automake --copy --debug --force && ./autogen.sh 
	cd $(APP_BSP_IPTABLES_DIR) && ./configure --host=$(HOST) --target=$(COMPILE_TOOLCHAIN) --with-kernel=$(IPTABLE_KERNEL_DIR) --prefix=$(APP_BSP_IPTABLES_INSTALL_DIR) --enable-static --disable-nftables --disable-shared CFLAGS="$(CFG_CFLAGS)"
	$(MAKE) -C $(APP_BSP_IPTABLES_DIR)
	$(MAKE) -C $(APP_BSP_IPTABLES_DIR) install
	if test -e $(APP_BSP_IPTABLES_INSTALL_DIR)/sbin/xtables-multi; \
	then echo "Compile iptables 1.6.1 success"; \
	else echo "Compile iptables 1.6.1 error!"; exit 1; \
	fi
	$(STRIP) --strip-unneeded $(APP_BSP_IPTABLES_INSTALL_DIR)/sbin/xtables-multi
	echo "Install iptables 1.6.1"
	$(call BspExclUsrBinInstall, $(APP_BSP_IPTABLES_INSTALL_DIR)/sbin, iptables)
	$(call BspExclUsrBinInstall, $(APP_BSP_IPTABLES_INSTALL_DIR)/sbin, xtables-multi)
	
iptables_bsp_clean:
	echo "Clean iptables 1.6.1"
	-$(MAKE) -C $(APP_BSP_IPTABLES_DIR) clean
	-$(MAKE) -C $(APP_BSP_IPTABLES_DIR) distclean
	echo "Uninstall iptables 1.6.1"
	rm -rf $(APP_BSP_IPTABLES_INSTALL_DIR)
	$(call BspExclUsrBinClean, iptables)
