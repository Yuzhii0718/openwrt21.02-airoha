mxml_bsp:
	echo "Build BSP mxml"
	$(MAKE) -C $(APP_BSP_MXML_DIR)
	if test -e $(APP_BSP_MXML_DIR)/libmxml.so.1.4; \
	then echo "Compile mxml success"; \
	else echo "Compile mxml error!"; exit 1; \
	fi
	$(STRIP) --strip-unneeded $(APP_BSP_MXML_DIR)/libmxml.so.1.4
	$(MAKE) -C $(APP_BSP_MXML_DIR) install
	cp -rf $(APP_BSP_MXML_DIR)/libmxml.so*  $(BSP_EXCL_LIB)
	cp -rf $(APP_BSP_MXML_DIR)/mxml.h $(BSP_EXCL_INC)
	
mxml_bsp_clean:
	echo "Clean BSP mxml"
	$(MAKE) -C $(APP_BSP_MXML_DIR) clean
