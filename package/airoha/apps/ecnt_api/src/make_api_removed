#Build wappd daemon
wappd:
ifneq ($(strip $(TCSUPPORT_MAP_WAPP)),)
	echo "Build wappd"
ifneq ($(strip $(TC_BUILD_RELEASECODE)),)
	echo "TC_BUILD_RELEASECODE"

	cp -f $(RELEASE_BSP_DIR)/$(TCPLATFORM)/filesystem/userfs/bin/wapp $(BSP_INT_FS)/userfs/bin/
	cp -f $(RELEASE_BSP_DIR)/$(TCPLATFORM)/filesystem/userfs/bin/wappctrl $(BSP_INT_FS)/userfs/bin/
	cp -f $(RELEASE_BSP_DIR)/$(TCPLATFORM)/filesystem/userfs/bin/libwapp_usr_intf_client.a $(BSP_INT_FS)/userfs/bin/
	cp -f $(RELEASE_BSP_DIR)/$(TCPLATFORM)/app_bsp/private/API/wappd/config_and_icon_files/* $(BSP_INT_FS)/usr/etc/
	
	cp -f $(RELEASE_BSP_DIR)/$(TCPLATFORM)/filesystem/userfs/bin/wapp $(BSP_EXT_FS)/userfs/bin/
	cp -f $(RELEASE_BSP_DIR)/$(TCPLATFORM)/filesystem/userfs/bin/wappctrl $(BSP_EXT_FS)/userfs/bin/
	cp -f $(RELEASE_BSP_DIR)/$(TCPLATFORM)/filesystem/userfs/bin/libwapp_usr_intf_client.a $(BSP_EXT_FS)/userfs/bin/
	cp -f $(RELEASE_BSP_DIR)/$(TCPLATFORM)/app_bsp/private/API/wappd/config_and_icon_files/* $(BSP_EXT_FS)/usr/etc/
	

else
	$(MAKE) -C $(BSP_API_MAP_WAPPD_DIR)
	if test -e $(BSP_API_MAP_WAPPD_DIR)/wapp; \
	then echo "Compile wappd success"; \
	else echo "Compile wappd error!"; exit 1; \
	fi
	$(call EcntBSPReleaseUsrfsBinInstall, $(BSP_API_MAP_WAPPD_DIR), wapp)
	$(call EcntBSPReleaseUsrfsBinInstall, $(BSP_API_MAP_WAPPD_DIR), wappctrl)
	$(call EcntBSPReleaseUsrfsBinInstall, $(BSP_API_MAP_WAPPD_DIR), libwapp_usr_intf_client.a)
	$(call EcntBSPReleaseInstall,$(BSP_API_MAP_WAPPD_DIR)/config_and_icon_files/, *, $(RELEASE_BSP_DIR)/$(TCPLATFORM)/app_bsp/private/API/wappd/config_and_icon_files)

	#cp $(BSP_API_MAP_WAPPD_DIR)/wapp  $(FILESYSTEM_DIR)/userfs/bin/
	#cp $(BSP_API_MAP_WAPPD_DIR)/wappctrl  $(FILESYSTEM_DIR)/userfs/bin/
	#cp $(BSP_API_MAP_WAPPD_DIR)/config_and_icon_files/* $(FILESYSTEM_DIR)/usr/etc/
endif

endif

wappd_clean:
ifneq ($(strip $(TCSUPPORT_MAP_WAPP)),)
	echo "Clean wappd"
ifneq ($(strip $(TC_BUILD_RELEASECODE)),)
	echo "TC_BUILD_RELEASECODE"
else
	$(MAKE) -C $(BSP_API_MAP_WAPPD_DIR) clean
endif
endif

