+static int get_dev_by_ipv6(char *wan_dev, struct in6_addr *ipl)
+{
+	FILE *fh;
+	char buf[512];
+	int err = -1;
+
+	fh = fopen("/proc/net/dev", "r");
+	if (!fh) {
+		return -1;
+	}
+	fgets(buf, sizeof buf, fh);	/* eat line */
+	fgets(buf, sizeof buf, fh);
+
+	while (fgets(buf, sizeof buf, fh)) {
+		char *s, name[128];
+		s = get_name(name, buf);
+		if(is_dev_ipv6_addr_match(name, &ipl_v6)){
+			strncpy(wan_dev, name, 16);
+			err = 0;
+			break;
+		}
+	}
+
+	fclose(fh);
+	return err;
+}
