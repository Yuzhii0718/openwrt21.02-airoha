+int set_traffic_speedtest_setting(int lport, int rport, unsigned int ipl, unsigned int ipr, unsigned int ppp, unsigned int flag, int duration, char role)
+{
+	int i = 0;
+	char cmd[128] = {0};
+	char wandev[32];
+	int cport_local = 0;
+
+	if(role == 'c'){
+		cport_local = lport;
+	}else{
+		cport_local = rport;
+	}
+	
+	for(i=0;i<8;i++){
+		if(cport_local == cport[i])
+			return 1;
+	}
+	for(i=0;i<8;i++){
+		if(cport[i] == 0){
+			cport[i] = cport_local;
+			break;
+		}
+	}
+
+	system("echo ctrl agg_num 8 > /proc/lro_wan");
+
+	if(0 == get_dev_by_ip(wandev, ipl))
+	{
+		memset(cmd,0,sizeof(cmd));
+		sprintf(cmd, "echo wandev=%s > /proc/tc3162/speed_test", wandev);
+		system(cmd);
+	}
+
+	if(ppp){
+		system("echo ppp > /proc/tc3162/speed_test");
+	}else{
+		system("echo ip > /proc/tc3162/speed_test");
+	}
+
+	ipr = htonl(ipr);
+	ipl = htonl(ipl);
+	memset(cmd,0,sizeof(cmd));
+	sprintf(cmd,"echo gateway=%d.%d.%d.%d > /proc/tc3162/speed_test",(ipr>>24), (ipr>>16)&0xFF, (ipr>>8)&0xFF, ipr&0xFF);
+	system(cmd);
+	
+	memset(cmd,0,sizeof(cmd));
+	sprintf(cmd,"echo mask=255.255.255.255 > /proc/tc3162/speed_test");
+	system(cmd);
+
+	memset(cmd,0,sizeof(cmd));
+	sprintf(cmd,"echo destip=%d.%d.%d.%d > /proc/tc3162/speed_test",(ipr>>24), (ipr>>16)&0xFF, (ipr>>8)&0xFF, ipr&0xFF);
+	system(cmd);
+	
+	memset(cmd,0,sizeof(cmd));
+	sprintf(cmd,"echo localip=%d.%d.%d.%d > /proc/tc3162/speed_test",(ipl>>24), (ipl>>16)&0xFF, (ipl>>8)&0xFF, ipl&0xFF);
+	system(cmd);
+
+	memset(cmd,0,sizeof(cmd));
+	sprintf(cmd,"echo destport=%d > /proc/tc3162/speed_test",rport);
+	system(cmd);
+	
+	memset(cmd,0,sizeof(cmd));
+	sprintf(cmd,"echo localport=%d > /proc/tc3162/speed_test",lport);
+	system(cmd);
+	
+	memset(cmd,0,sizeof(cmd));
+	sprintf(cmd,"echo duration=%d > /proc/tc3162/speed_test",duration);
+	system(cmd);
+
+	if(flag == 1){
+		memset(cmd,0,sizeof(cmd));
+		sprintf(cmd,"echo tso_enable=1 > /proc/tc3162/speed_test");
+		system(cmd);
+	}else{
+		memset(cmd,0,sizeof(cmd));
+		sprintf(cmd,"echo tso_enable=0 > /proc/tc3162/speed_test");
+		system(cmd);
+	}
+	
+	memset(cmd,0,sizeof(cmd));
+	sprintf(cmd,"echo action=APPTEST_P > /proc/tc3162/speed_test");
+	system(cmd);	
+	
+	return 0;	
+}
