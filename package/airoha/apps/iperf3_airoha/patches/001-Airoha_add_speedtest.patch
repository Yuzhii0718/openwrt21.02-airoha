+int iperf_speedtest_setting(struct iperf_test *test, struct iperf_stream *sp)
+{
+	uint32_t ipl, ipr;
+	int lport, rport;
+	int ppp = 0;
+	int i = 0;
+	int flag = 0;
+	
+	if(!test->speedtest)
+		return 0;
+
+	ipl = ((struct sockaddr_in *) &sp->local_addr)->sin_addr.s_addr;
+	ipr = ((struct sockaddr_in *) &sp->remote_addr)->sin_addr.s_addr;
+	lport = ntohs(((struct sockaddr_in *) &sp->local_addr)->sin_port);
+	rport = ntohs(((struct sockaddr_in *) &sp->remote_addr)->sin_port);
+
+	if(test->isppp == 1)
+		ppp = test->isppp;
+	if(test->speedtest == 1)
+		flag = 0;
+	else
+		flag = 1;	
+	
+	return set_traffic_speedtest_setting(lport, rport, ipl, ipr, ppp, flag, test->duration,test->role);
+	
+}
+
