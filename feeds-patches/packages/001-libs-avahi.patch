+-
++        /*hijack sepecific hostname*/
++        if((strcmp("mywifiext.local", key->name)) == 0) 
++            hijack_specific_hostname(s, p, i, a, port, legacy_unicast, unicast_response);
+         avahi_server_prepare_matching_responses(s, i, key, unicast_response);
+         avahi_key_unref(key);
+     }
