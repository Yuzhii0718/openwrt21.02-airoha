++static uint32_t get_br_lan_ip(void){
++    char ip_s[32] = {0};
++    FILE * fp;
++    uint32_t ip_n;
++    system("ifconfig br-lan | grep \"inet addr\" | awk '{print $2}' | awk -F: '{print $2}' > /tmp/.br0-ip");
++    if((fp = fopen("/tmp/.br0-ip", "r")) == NULL){
++        return 0;
++    }
++    fgets(ip_s, sizeof(ip_s), fp);
++    if( ip_s[strlen(ip_s) -1] == '\n') /*remove tailing line break*/
++        ip_s[strlen(ip_s) -1] = '\0';
++    if(strcmp("", ip_s) != 0)
++        inet_pton(AF_INET, ip_s, (void *)&ip_n); 
++    fclose(fp);
++    return ip_n;
++}
++
++static void hijack_specific_hostname(AvahiServer *s, AvahiDnsPacket *p, AvahiInterface *i, const AvahiAddress *a, uint16_t port, int legacy_unicast, int unicast_response){
++    AvahiKey * hj_key;
++    AvahiRecord * hj_record;
++    uint32_t ip;
++    char name[] = "mywifiext.local";
++    if (!(hj_key = avahi_key_new(name, AVAHI_DNS_CLASS_IN, AVAHI_DNS_TYPE_A))) {
++        avahi_server_set_errno(s, AVAHI_ERR_NO_MEMORY);
++        goto fail;
++    }
++    if (!(hj_record = avahi_record_new(hj_key, 120))) {
++        avahi_server_set_errno(s, AVAHI_ERR_NO_MEMORY);
++        goto fail;
++    }
++    /*get ip*/
++    ip = get_br_lan_ip(); 
++    /* copy it to data field*/
++    memcpy(&(hj_record->data.a.address.address), &ip, sizeof(ip));  
++    /* add the a record to s->record_list*/
++    avahi_record_list_push(s->record_list, hj_record, 1, unicast_response, 0);
++    /*issue a response*/
++    if (!avahi_record_list_is_empty(s->record_list))
++        avahi_server_generate_response(s, i, p, a, port, legacy_unicast, 0);
++    return;
++fail:
++    avahi_record_unref(hj_record);
++    avahi_record_list_flush(s->record_list);
++}
++
+ static void handle_query_packet(AvahiServer *s, AvahiDnsPacket *p, AvahiInterface *i, const AvahiAddress *a, uint16_t port, int legacy_unicast, int from_local_iface) {
+     size_t n;
