+-//09txtvers=110mac=3497F60071318joined=138devname=\060\064\035\037\038\040\036_\035\033-\\\043\062
+-//txtvers=1mac=3497F6007131joined=1devname=\060\064\035\037\038\040\036_\035\033-\\\043\062
+-//1            13                 32       41
+-int parse_txt_record(char * record, char * ip){
+-    char  MAC[32] = "";
+-    char *r;
+-    char joined;
+-    char name[DEV_NAME_MAX] = "";
+-    size_t len;
+-
+-    len = strlen(record);
+-
+-    r = record;
+-    r += 13;
+-    //parse mac
+-    int i = 0;
+-    for(i = 0; i < 6; i++){
+-        strncpy(MAC + 3 * i, r, 2);
+-        strncpy(MAC + 3 * i - 1, ":", 1);
+-        r += 2;
+-    }
+-    MAC[18] = 0;
+-
+-    //parse joined
+-    r = record;
+-    r += 32;
+-    joined = *r;
+-
+-    //parse devname
+-    r = record;
+-    r += 41;
+-    strncpy(name, r, (int)len - 41);
+-    name[(int)len - 41] = 0;
+-
+-    sprintf(record, "%s %s %s @#$&*!", MAC, ip, name);
+-    return 0;
+-}
+ int usage(char * arg){
+     printf("Usage: %s <eu>\n" 
+-            "\t-e                   \tgenerate escaped device name\n"
+-            "\t-p <txt-record> <ip> \tprint txt record\n", arg);
++            "\t-e    generate escaped device name\n"
++            "\t-p    print txt record(read a record from /tmp/mdns_a_record_tmp,"
++			"\t      read txt record from /tmp/mdns_txt_record_tmp)\n", arg);
+     return 0;
+ }
