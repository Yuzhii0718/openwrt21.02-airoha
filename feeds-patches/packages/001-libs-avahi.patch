++int hex2dec(char* value){
++    int digit, i, j, result;
++
++    result=0;
++    digit=0;
++    for(i=strlen(value) - 1, j = 0; i >= 0; i--, j++ ){
++        if (value[i] >= '0' && value[i] <= '9')
++            digit = value[i] - '0';
++        if (value[i] >= 'a' && value[i] <= 'f')
++            digit = value[i] - 'a' + 10;
++        if (value[i] >= 'A' && value[i] <= 'F')
++            digit = value[i] - 'A' + 10;
++        result += digit * hexpow(j);
++    }
++    return result;
++}
