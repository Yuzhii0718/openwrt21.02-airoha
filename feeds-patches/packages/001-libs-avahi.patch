+-char * generate_escaped_devicename(char * record){
+-    char *dev_name, *pname;
+-    char dname[DEV_NAME_MAX] = "", name[DEV_NAME_MAX] = "";
+-    size_t len;
+-    //dev_name = "<@#%&($_#!-\\+>";
+-    dev_name = "EAX15";//config_get("netbiosname"); // all config_get use the same one global buf
+-    strncpy(dname, dev_name, strlen(dev_name));
+-    dev_name = dname;
+-
+-    //get device name
+-    len = sizeof(name);
+-    pname = name;
+-
+-    escape_device_name(dev_name, strlen(dev_name), &pname, &len);
+-
+-    sprintf(record, "devname=%s", name);
+-    record[strlen(record)] = 0;
+-    return record;
+-}
+-// hex power
+-int hexpow(int pow){
+-    int result = 1;
+-    while( (pow--) > 0){
+-        result *= 16;
+-    }
+-    return result;
+-}
+-
+-int hex2dec(char* value){
+-    int digit, i, j, result;
+-
+-    result=0;
+-    digit=0;
+-    for(i=strlen(value) - 1, j = 0; i >= 0; i--, j++ ){
+-        if (value[i] >= '0' && value[i] <= '9')
+-            digit = value[i] - '0';
+-        if (value[i] >= 'a' && value[i] <= 'f')
+-            digit = value[i] - 'a' + 10;
+-        if (value[i] >= 'A' && value[i] <= 'F')
+-            digit = value[i] - 'A' + 10;
+-        result += digit * hexpow(j);
+-    }
+-    return result;
+-}
